# Midden environment configuration.
#
# Copy this file to `.env` in the same folder and fill in the real values:
#     cp .env.example .env       (PowerShell:  Copy-Item .env.example .env)
#
# `.env` is gitignored — never commit it. Midden loads it on startup; real
# environment variables take precedence over what's set here.

# REQUIRED. API key for the LAN LLM server (llama.cpp + llama-swap on FIEF).
# `midden serve` refuses to launch without it. See windows-sysadmin/CONNECT.md;
# the live key is also in C:\Tools\llama-swap\apikey.txt on the server.
MIDDEN_LLM_API_KEY=sk-fief-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. Override the LLM base URL (default: http://192.168.1.208:8080/v1).
# Accepts a full URL or a bare host[:port]; the /v1 suffix is added if missing.
# MIDDEN_LLM_BASE=http://192.168.1.208:8080/v1
